# Use one of the two database modes below.

# Mode 1: single DATABASE_URL, useful for Supabase or hosted Postgres.
DATABASE_URL=postgresql://username:password@host:5432/database
DB_SSL=false

# Mode 2: local docker-compose Postgres if DATABASE_URL is omitted.
DB_HOST=localhost
DB_PORT=5433
DB_USER=root
DB_PASSWORD=password123
DB_NAME=smartcity_db

PORT=5000
CORS_ORIGIN=http://localhost:5173